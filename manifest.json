  "shortcuts": [
    {
      "name": "بيع جديد",
      "short_name": "بيع جديد",
      "description": "بدء عملية بيع جديدة",
      "url": "/?action=new-sale",
      "icons": [
        {
          "src": "assets/icons/shortcut-sale.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "إدارة المنتجات",
      "short_name": "المنتجات",
      "description": "إدارة المنتجات والمخزون",
      "url": "/?action=products",
      "icons": [
        {
          "src": "assets/icons/shortcut-products.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "التقارير",
      "short_name": "التقارير",
      "description": "عرض التقارير والإحصائيات",
      "url": "/?action=reports",
      "icons": [
        {
          "src": "assets/icons/shortcut-reports.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "العملاء",
      "short_name": "العملاء",
      "description": "إدارة العملاء والديون",
      "url": "/?action=customers",
      "icons": [
        {
          "src": "assets/icons/shortcut-customers.png",
          "sizes": "96x96"
        }
